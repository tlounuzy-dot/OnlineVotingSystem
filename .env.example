# Copy this file to .env and set your local values. Do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL configuration. Set DB_USER and DB_PASSWORD for your own local account.
DB_ENGINE=django.db.backends.mysql
DB_NAME=online_voting_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value private and out of version control.
VOTE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
