# Copy this file to .env and set your local values. Do not commit .env.
DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local WebAuthn defaults. start-mobile-test.bat supplies temporary HTTPS
# tunnel values through its process environment; do not place tunnel URLs here.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000

# Local development prints OTPs to the Django server console. To send real
# email, set the SMTP backend and all provider values below. Never commit a
# provider password or app password in .env.example.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=your-address@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@example.com
# EMAIL_HOST_PASSWORD=provider-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10

# MySQL configuration. Set DB_USER and DB_PASSWORD for your own local account.
DB_ENGINE=django.db.backends.mysql
DB_NAME=online_voting_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value private and out of version control.
VOTE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# OTP delivery controls. Email uses DJANGO_EMAIL_BACKEND above. SMS uses
# Infobip; WhatsApp remains on Twilio. Never commit real provider credentials.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
INFOBIP_API_BASE_URL=https://your-subdomain.api.infobip.com
INFOBIP_API_KEY=
# ServiceSMS is Infobip's documented trial sender. Set an approved sender for production.
INFOBIP_SMS_SENDER=ServiceSMS
INFOBIP_SMS_TIMEOUT_SECONDS=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_NUMBER=
